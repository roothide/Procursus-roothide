 using namespace clang;
 using namespace CodeGen;
+
+PointerAuthSchema
+CodeGenModule::getArm64eDataPointerAuthSchema(uint16_t Discriminator) {
+  const auto &Opts = getLangOpts();
+  if (!getTriple().isArm64e() || !getTriple().isOSBinFormatMachO() ||
+      !Opts.PointerAuthCalls || Opts.SoftPointerAuth || Opts.Kernel ||
+      Opts.AppleKext)
+    return PointerAuthSchema();
+  return PointerAuthSchema(PointerAuthSchema::ARM8_3Key::ASDA, true,
+                           PointerAuthSchema::Discrimination::Constant,
+                           Discriminator);
+}
+
+PointerAuthSchema
+CodeGenModule::getVTablePointerAuthSchema(const CXXRecordDecl *RD) {
+  const auto &Default = getCodeGenOpts().PointerAuth.CXXVTablePointers;
+  if (!Default || !getArm64eDataPointerAuthSchema(0))
+    return Default;
+  if (!RD->isPolymorphic())
+    return PointerAuthSchema();
+  while (const auto *Base =
+             getContext().getASTRecordLayout(RD).getPrimaryBase()) {
+    if (Base == RD || !Base->isPolymorphic())
+      break;
+    RD = Base;
+  }
+  // Darwin's std::type_info ABI retains an undiscriminated vptr.
+  if (RD->getQualifiedNameAsString() == "std::type_info")
+    return Default;
+  llvm::SmallString<128> Name;
+  llvm::raw_svector_ostream Out(Name);
+  cast<ItaniumMangleContext>(getCXXABI().getMangleContext())
+      .mangleCXXVTable(RD, Out);
+  return getArm64eDataPointerAuthSchema(
+      getPointerAuthStringDiscriminator(getContext(), Out.str()));
+}
 
