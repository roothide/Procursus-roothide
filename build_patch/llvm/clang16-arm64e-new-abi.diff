+// RUN: %clang_cc1 -triple arm64e-apple-ios16.0 -fptrauth-calls -std=c++20 -emit-llvm -o - %s | FileCheck %s --check-prefix=NATIVE
+// RUN: %clang_cc1 -triple arm64e-apple-ios16.0 -fptrauth-calls -std=c++20 -emit-llvm -o - %s | FileCheck %s --check-prefix=NONPOLY
+// RUN: %clang_cc1 -triple arm64-apple-ios16.0 -fptrauth-calls -std=c++20 -emit-llvm -o - %s | FileCheck %s --check-prefix=LEGACY
+// RUN: %clang_cc1 -triple arm64e-apple-ios16.0 -std=c++20 -emit-llvm -o - %s | FileCheck %s --check-prefix=DISABLED
+
+// Nested array elements and secondary bases need their actual storage addresses.
+// NATIVE-DAG: i32 2, i64 ptrtoint (ptr getelementptr inbounds ({{.*}}, ptr @nativeStaticStorage, i32 0, i32 1, i32 0, i32 0) to i64), i64 8687
+// NATIVE-DAG: i32 2, i64 ptrtoint (ptr getelementptr inbounds ({{.*}}, ptr @nativeStaticStorage, i32 0, i32 1, i32 1, i32 2) to i64), i64 57007
+// Equal virtual adjustments for two base types must not share an auth thunk.
+// NATIVE-DAG: define {{.*}} @_ZTv0_n32_NK14NativeTwoRoots5valueEvU11__vtptrauthILj0Lb1Lj20797E(
+// NATIVE-DAG: define {{.*}} @_ZTv0_n32_NK14NativeTwoRoots5valueEv(
+// LEGACY-NOT: __vtptrauth
+// DISABLED-NOT: section "llvm.ptrauth"
+
+struct NativeRootA {
+  int a = 1;
+  virtual ~NativeRootA() = default;
+  virtual int value() const { return a; }
+};
+struct NativeRootB {
+  int b = 2;
+  virtual ~NativeRootB() = default;
+  virtual int value() const { return b; }
+};
+struct NativeTwoRoots : virtual NativeRootA, virtual NativeRootB {
+  int value() const override { return 42; }
+};
+int call_roots() {
+  auto *object = new NativeTwoRoots;
+  NativeRootA *a = object;
+  NativeRootB *b = object;
+  int value = a->value() + b->value();
+  delete b;
+  return value;
+}
+
+struct NativeStaticLeft {
+  int left;
+  constexpr NativeStaticLeft(int value = 40) : left(value) {}
+  virtual int leftValue() const { return left + 2; }
+};
+struct NativeStaticRight {
+  int right;
+  constexpr NativeStaticRight(int value = 41) : right(value) {}
+  virtual int rightValue() const { return right + 1; }
+};
+struct NativeStaticBoth : NativeStaticLeft, NativeStaticRight {
+  constexpr NativeStaticBoth() = default;
+};
+struct NativeStaticStorage { int prefix; NativeStaticBoth objects[2]; };
+extern constexpr NativeStaticStorage nativeStaticStorage = {17, {{}, {}}};
+int call_constant(const NativeStaticRight *right) { return right->rightValue(); }
+int constant_value() { return call_constant(&nativeStaticStorage.objects[1]); }
+
+struct NativePlainRoot { int number; };
+struct NativePlainMiddle : virtual NativePlainRoot { int middle; };
+// Non-polymorphic virtual inheritance uses a raw vptr in the native ABI.
+// NONPOLY-LABEL: define{{.*}} @_Z12nonpoly_cast
+// NONPOLY-NOT: llvm.ptrauth
+// NONPOLY: ret ptr
+NativePlainRoot *nonpoly_cast(NativePlainMiddle *object) { return object; }
