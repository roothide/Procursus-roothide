+// RUN: %clang_cc1 -triple arm64e-apple-ios16.0 -fptrauth-calls -std=c++20 -emit-llvm -o - %s | FileCheck %s
+
+// Model the platform's std::type_info declaration without system headers.
+namespace std {
+class type_info {
+  const char *name;
+protected:
+  explicit type_info(const char *value) : name(value) {}
+public:
+  virtual ~type_info();
+};
+}
+struct NativeTypeRoot : std::type_info {
+  NativeTypeRoot() : std::type_info("local") {}
+  virtual int value() const { return 1; }
+};
+struct NativeNormalRoot {
+  int number = 2;
+  virtual ~NativeNormalRoot() = default;
+  virtual int value() const { return number; }
+};
+struct NativeMixedRoots : virtual NativeTypeRoot, virtual NativeNormalRoot {
+  int value() const override { return 42; }
+};
+int check_types() {
+  auto *object = new NativeMixedRoots;
+  NativeTypeRoot *type = object;
+  NativeNormalRoot *normal = object;
+  int value = type->value() + normal->value();
+  delete type;
+  return value;
+}
+
+// Use the explicit process-independent key override (3) for the type_info ABI.
+// CHECK-DAG: define {{.*}} @_ZTv0_n32_NK16NativeMixedRoots5valueEvU11__vtptrauthILj3Lb0Lj0E(
+// CHECK-DAG: define {{.*}} @_ZTv0_n32_NK16NativeMixedRoots5valueEv(
+// CHECK-DAG: call i64 @llvm.ptrauth.auth({{.*}}, i32 2, i64 0)
