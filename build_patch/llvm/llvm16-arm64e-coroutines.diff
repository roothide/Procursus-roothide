+// Materialize the schema carried by a signed continuation prototype.
+static Value *emitSignedRetconPointer(IRBuilder<> &Builder,
+                                      const GlobalPtrAuthInfo &Schema,
+                                      Constant *Pointer, Value *Storage) {
+  Module *M = Builder.GetInsertBlock()->getModule();
+  if (!Schema.hasAddressDiversity())
+    return Schema.createWithSameSchema(*M, Pointer);
+
+  Type *IntPtrTy = Schema.getAddrDiscriminator()->getType();
+  Value *Discriminator = Builder.CreatePtrToInt(Storage, IntPtrTy);
+  auto *Extra = const_cast<ConstantInt *>(Schema.getDiscriminator());
+  if (!Extra->isNullValue())
+    Discriminator = Builder.CreateCall(
+        Intrinsic::getDeclaration(M, Intrinsic::ptrauth_blend),
+        {Discriminator, Extra});
+  Value *Signed = Builder.CreateCall(
+      Intrinsic::getDeclaration(M, Intrinsic::ptrauth_sign),
+      {Builder.CreatePtrToInt(Pointer, IntPtrTy),
+       const_cast<ConstantInt *>(Schema.getKey()), Discriminator});
+  return Builder.CreateIntToPtr(Signed, Pointer->getType());
+}
