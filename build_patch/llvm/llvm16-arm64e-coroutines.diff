+; RUN: opt -opaque-pointers=0 -passes='coro-early,cgscc(coro-split),coro-cleanup,function(instcombine)' -S %s | FileCheck %s
+; Backported from swiftlang/llvm-project commits cd67f1d and ebfd7ce4.
+; Test both constant-only and coroutine-buffer-discriminated continuations.
+;
+; CHECK: [[F_SIGNED:@.*]] = private constant {{.*}}@f.resume.0{{.*}}i32 2, i64 0, i64 12867
+; CHECK-LABEL: define i8* @f(
+; CHECK: ret i8* bitcast ({{.*}}[[F_SIGNED]] to i8*)
+; CHECK-LABEL: define internal i8* @f.resume.0(
+; CHECK: [[F_SIGNED]]
+; CHECK-LABEL: define i8* @g(i8* %buffer,
+; CHECK: [[ADDR:%.*]] = ptrtoint i8* %buffer to i64
+; CHECK-NEXT: [[BLEND:%.*]] = call i64 @llvm.ptrauth.blend(i64 [[ADDR]], i64 8723)
+; CHECK-NEXT: [[SIGNED:%.*]] = call i64 @llvm.ptrauth.sign(i64 ptrtoint (i8* (i8*, i1)* @g.resume.0 to i64), i32 2, i64 [[BLEND]])
+; CHECK-NEXT: [[PTR:%.*]] = inttoptr i64 [[SIGNED]] to i8*
+; CHECK-NEXT: ret i8* [[PTR]]
+; CHECK-LABEL: define internal i8* @g.resume.0(i8* {{.*}}%0,
+; CHECK: [[RESUME_ADDR:%.*]] = ptrtoint i8* %0 to i64
+; CHECK-NEXT: [[RESUME_BLEND:%.*]] = call i64 @llvm.ptrauth.blend(i64 [[RESUME_ADDR]], i64 8723)
+; CHECK-NEXT: call i64 @llvm.ptrauth.sign(i64 ptrtoint (i8* (i8*, i1)* @g.resume.0 to i64), i32 2, i64 [[RESUME_BLEND]])
+
+target datalayout = "E-p:64:64"
+
+%swift.type = type { i64 }
+%swift.opaque = type opaque
+%T4red215EmptyCollectionV = type opaque
+%TSi = type <{ i64 }>
+
+@prototype.signed = private constant { i8*, i32, i64, i64 } { i8* bitcast (i8* (i8*, i1)* @prototype to i8*), i32 2, i64 0, i64 12867 }, section "llvm.ptrauth"
+
+define i8* @f(i8* %buffer, i32 %n) {
+entry:
+  %id = call token @llvm.coro.id.retcon(i32 8, i32 4, i8* %buffer, i8* bitcast ({ i8*, i32, i64, i64 }* @prototype.signed to i8*), i8* bitcast (i8* (i32)* @allocate to i8*), i8* bitcast (void (i8*)* @deallocate to i8*))
+  %hdl = call i8* @llvm.coro.begin(token %id, i8* null)
+  br label %loop
+
+loop:
+  %n.val = phi i32 [ %n, %entry ], [ %inc, %resume ]
+  call void @print(i32 %n.val)
+  %unwind0 = call i1 (...) @llvm.coro.suspend.retcon.i1()
+  br i1 %unwind0, label %cleanup, label %resume
+
+resume:
+  %inc = add i32 %n.val, 1
+  br label %loop
+
+cleanup:
+  call i1 @llvm.coro.end(i8* %hdl, i1 0)
+  unreachable
+}
+
+
+
+
+@g.prototype.signed = private constant { i8*, i32, i64, i64 } { i8* bitcast (i8* (i8*, i1)* @prototype to i8*), i32 2, i64 1, i64 8723 }, section "llvm.ptrauth"
+
+define i8* @g(i8* %buffer, i32 %n) {
+entry:
+  %id = call token @llvm.coro.id.retcon(i32 8, i32 4, i8* %buffer, i8* bitcast ({ i8*, i32, i64, i64 }* @g.prototype.signed to i8*), i8* bitcast (i8* (i32)* @allocate to i8*), i8* bitcast (void (i8*)* @deallocate to i8*))
+  %hdl = call i8* @llvm.coro.begin(token %id, i8* null)
+  br label %loop
+
+loop:
+  %n.val = phi i32 [ %n, %entry ], [ %inc, %resume ]
+  call void @print(i32 %n.val)
+  %unwind0 = call i1 (...) @llvm.coro.suspend.retcon.i1()
+  br i1 %unwind0, label %cleanup, label %resume
+
+resume:
+  %inc = add i32 %n.val, 1
+  br label %loop
+
+cleanup:
+  call i1 @llvm.coro.end(i8* %hdl, i1 0)
+  unreachable
+}
