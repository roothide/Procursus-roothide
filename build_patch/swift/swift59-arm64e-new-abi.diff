@@ -0,0 +1,16 @@
+#include <stdint.h>
+#include <ptrauth.h>
+
+#if __has_feature(ptrauth_calls)
+#define NATIVE_PTRAUTH(key, address, extra) __ptrauth(key, address, extra)
+#else
+#define NATIVE_PTRAUTH(key, address, extra)
+#endif
+
+typedef struct {
+  int32_t * NATIVE_PTRAUTH(2, 1, 4321) _Nullable optional;
+  int32_t * NATIVE_PTRAUTH(2, 1, 4321) _Nonnull required;
+  int32_t (* NATIVE_PTRAUTH(0, 1, 1234) _Nonnull function)(int32_t);
+} NativeFields;
+
+NativeFields * _Nonnull nativeFields(void);
