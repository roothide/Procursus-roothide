 using namespace swift;
 using namespace irgen;
+
+clang::PointerAuthSchema
+irgen::getArm64eDataPointerAuthSchema(IRGenModule &IGM,
+                                     uint16_t discriminator) {
+  const auto &functions = IGM.getOptions().PointerAuth.FunctionPointers;
+  if (IGM.Triple.getArchName() != "arm64e" || !IGM.Triple.isOSBinFormatMachO() ||
+      !functions || functions.getKind() != PointerAuthSchema::Kind::ARM8_3)
+    return {};
+  return PointerAuthSchema(PointerAuthSchema::ARM8_3Key::ASDA,
+                           /*address*/ true,
+                           PointerAuthSchema::Discrimination::Constant,
+                           discriminator);
+}
+
+void irgen::addArm64eDataPointer(IRGenModule &IGM,
+                                ConstantAggregateBuilderBase &builder,
+                                llvm::Constant *pointer,
+                                uint16_t discriminator) {
+  if (pointer->isNullValue())
+    return builder.add(pointer);
+  builder.addSignedPointer(pointer,
+                           getArm64eDataPointerAuthSchema(IGM, discriminator),
+                           PointerAuthEntity());
+}
 
