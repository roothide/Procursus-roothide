+// RUN: %target-swift-frontend -emit-ir -module-name NativeFieldsTest -enable-import-ptrauth-field-function-pointers -I %S/Inputs/NativePtrauthFields %s | %FileCheck %s
+// REQUIRES: CPU=arm64e
+
+import NativePtrauthFields
+
+// CHECK-LABEL: define {{.*}}@native_read_data
+// CHECK: @llvm.ptrauth.auth{{.*}}i32 2
+// CHECK-NOT: @llvm.ptrauth.resign
+// CHECK: ret
+@_silgen_name("native_read_data")
+public func readNativeData(_ fields: UnsafeMutablePointer<NativeFields>) -> Int32 {
+  return fields.pointee.required.pointee
+}
+
+// CHECK-LABEL: define {{.*}}@native_write_data
+// CHECK: @llvm.ptrauth.sign{{.*}}i32 2
+@_silgen_name("native_write_data")
+public func writeNativeData(_ fields: UnsafeMutablePointer<NativeFields>,
+                            _ value: UnsafeMutablePointer<Int32>) {
+  fields.pointee.required = value
+}
+
+// A nonnull C function pointer must still be re-signed for a C call.
+// CHECK-LABEL: define {{.*}}@native_read_function
+// CHECK: @llvm.ptrauth.resign
+@_silgen_name("native_read_function")
+public func readNativeFunction(_ fields: UnsafeMutablePointer<NativeFields>) -> Int32 {
+  return fields.pointee.function(40)
+}
