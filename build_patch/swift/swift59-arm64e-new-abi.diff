+
+uint16_t LinkEntity::getGOTPointerAuthDiscriminator() const {
+  switch (getKind()) {
+  case Kind::ProtocolConformanceDescriptor:
+    return SpecialPointerAuthDiscriminators::ProtocolConformanceDescriptor;
+  case Kind::ValueWitnessTable:
+    return SpecialPointerAuthDiscriminators::ValueWitnessTable;
+  case Kind::AssociatedTypeDescriptor:
+  case Kind::AssociatedConformanceDescriptor:
+  case Kind::BaseConformanceDescriptor:
+    return 0x7D4C; // ptrauth_string_discriminator("ProtocolRequirement")
+  case Kind::MethodDescriptor:
+  case Kind::MethodDescriptorDerivative:
+  case Kind::MethodDescriptorInitializer:
+  case Kind::MethodDescriptorAllocator:
+    return isa<ProtocolDecl>(getDecl()->getDeclContext()) ? 0x7D4C : 0x675A;
+  default:
+    return 0;
+  }
 }
 
