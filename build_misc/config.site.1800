# config.site presets for CFVER 1800 (iOS 15 deployment target).
#
# Sourced by every autoconf `configure` via CONFIG_SITE (wired in the top-level
# Makefile, selected automatically by $(MEMO_CFVER)).
#
# CONFIG_SITE names exactly ONE file: autoconf 2.69's configure treats
# $CONFIG_SITE as a single path (a space-separated list is quoted as one
# filename and silently skipped), which breaks every autoconf-2.69 package
# (sqlite3, findutils, gnupg, libtiff, ...). So this file is SELF-CONTAINED --
# it carries both the CFVER-independent toolchain pins and the iOS-15-specific
# symbol pins; nothing is inherited from a shared file.
#
# The symbol pins below are DECLARED by newer iPhoneOS SDKs but are ABSENT on the
# iOS versions this CFVER targets. Without pinning, autoconf's link-based checks
# (and gnulib's, which key off the same ac_cv_func_* cache var) detect them as
# present, so packages weak-import the symbol -> it binds to NULL at runtime ->
# pc=0 crash on older iOS. Pin them to "no" so the bundled fallback is built.
#
# Verify any build with: build_tools/check-weak-imports.sh build_stage/<target>/1800

# --- Toolchain pins (CFVER-independent) ---

# apple has deemed -single_module obsolete starting with xcode16
lt_cv_apple_cc_single_mod=yes

# --- iOS symbol availability pins ---

# strchrnul: SDK marks it "introduced in iOS 18.4"; absent on iOS 15~17.
ac_cv_func_strchrnul=no

# pipe2: SDK marks it "introduced in iOS 27.0"; absent on iOS 15~26.
ac_cv_func_pipe2=no

# dup3: SDK marks it "introduced in iOS 27.0"; absent on iOS 15~26.
ac_cv_func_dup3=no
